# Sanitized template only. Replace placeholders locally; never commit .env.dev.
APP_ENV=dev
DB_HOST=127.0.0.1
DB_PORT=<verified-local-mysql-port>
DB_NAME=careerops_dev
DB_USER=careerops_dev_app
DB_PASSWORD=<existing-dedicated-dev-account-password>
SESSION_SECRET=<local-dev-session-secret>
# Confirm the historical recording convention before replacing this placeholder.
SESSION_TREND_SOURCE_TIME_ZONE=<verified-historical-recording-zone>
# Optional local HTTP listener port (defaults to 3000).
PORT=3000
